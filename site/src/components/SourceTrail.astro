---
import {
  countRunEvidence,
  evidenceLinksForFinding,
  findingsForSources,
  formatEvidenceTarget,
  sourceLabelForId,
  type FindingEntry,
} from "../lib/frontier";

const {
  findings,
  sourceIds = [],
  runId,
  preferredFindingIds = [],
  title = "Sources",
  intro = "Primary links, including exact changelog lines when available.",
  evidenceRunId,
} = Astro.props as {
  findings?: FindingEntry[];
  sourceIds?: string[];
  runId?: string;
  preferredFindingIds?: string[];
  title?: string;
  intro?: string;
  evidenceRunId?: string;
};

const rows = (findings?.length ? findings : findingsForSources(sourceIds, runId, preferredFindingIds)).map((finding) => ({
  finding,
  evidence: evidenceLinksForFinding(finding),
}));

// One row per source is a sample, not the record. Where the full set exists,
// say how big it is and link it -- otherwise the prose has to carry it.
const evidenceCount = countRunEvidence(evidenceRunId);
const showAll = evidenceCount > rows.length;
---

{
  (rows.length > 0 || showAll) && (
    <section class="source-trail-section rule mt-10 pt-7">
      <p class="small-caps text-muted">{title}</p>
      <p class="source-trail-intro">
        {rows.length > 0 ? intro : "Every source swept for this issue, with the primary links each claim was checked against."}
      </p>
      {rows.length > 0 && (
      <ol class="source-trail">
        {rows.map(({ finding, evidence }) => (
          <li class="source-trail-row">
            <div class="source-trail-head">
              <a class="source-trail-name" href={`/findings/${finding.finding}/`}>
                {sourceLabelForId(finding.data.source)}
              </a>
            </div>
            <div class="source-trail-links">
              {evidence.map((item) => (
                <a class="source-trail-link" href={item.url}>
                  <span class="source-trail-kind">{(item.precision ?? "source").replace(/_/g, " ")}</span>
                  <span>
                    <span class="source-trail-label">{item.label}</span>
                    <span class="source-trail-target">{formatEvidenceTarget(item.url)}</span>
                  </span>
                </a>
              ))}
            </div>
          </li>
        ))}
      </ol>
      )}
      {showAll && (
        <p class="source-trail-all">
          <a href={`/runs/${evidenceRunId}/`}>
            All {evidenceCount} evidence records checked for this issue
          </a>
        </p>
      )}
    </section>
  )
}
