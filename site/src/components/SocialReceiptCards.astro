---
import SocialPostEmbed from "./SocialPostEmbed.astro";
import type { SocialReceiptCard } from "../lib/frontier";

const { cards = [] } = Astro.props as { cards: SocialReceiptCard[] };

// This used to render its own grid: kind label, byline, excerpt, summary, why it
// matters, verification, status, tags, caveat, all stacked as labelled fields.
// It carried the data and read like a spreadsheet of somebody's posts.
//
// It now renders the same post card the editorial uses, in research mode. One
// card design across the publication. A page showing what the field said should
// look like the field, and the extra fields a run page needs sit under the post
// rather than replacing it.
---

{
  cards.length > 0 && (
    <section class="rule mt-7 pt-6">
      <div class="social-receipts-head">
        <div>
          <p class="small-caps text-muted">What the field said</p>
          <h2 class="social-receipts-title">Public posts, captured as static evidence.</h2>
        </div>
        <p class="social-receipts-note">
          Each card renders from repository data alone, with no request to X at
          read time. A post is a receipt for what was said. It is never a receipt
          for what is true, and the status line on each card says how far the
          claim was checked.
        </p>
      </div>
      <div class="social-receipt-feed">
        {cards.map((card) => (
          <SocialPostEmbed card={card} research={true} />
        ))}
      </div>
    </section>
  )
}
