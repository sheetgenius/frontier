---
import { listPeople, localAvatar, type SocialReceiptCard } from "../lib/frontier";

// The feature treatment: one post per issue, at most, given its own space.
//
// No box, no rule, no tint, no platform logo. Separation is created entirely by
// air, a tighter measure, and a step up in size -- the way a book sets an
// extract. The avatar is the one non-typographic element, and it is served from
// our own origin so the page makes no request to any platform and the archive
// still shows the right face in five years.
//
// Every element in the attribution line is functional: the avatar and handle go
// to the person, the date goes to the artifact, the markers go to the apparatus.
// The full identifier is printed once, at the foot of the piece, where a reader
// who is checking our work will look for it and where it survives print and
// copy-paste. Repeating it here made it the loudest thing in the line.
const { card } = Astro.props as { card: SocialReceiptCard };

const handle = (card.authors?.[0] ?? "").replace(/^@/, "").trim();
const monogram = (handle.match(/[A-Za-z0-9]/)?.[0] ?? "?").toUpperCase();
const avatar = localAvatar(handle);

// A stable hue per handle, used for the monogram fallback and the ring.
let hash = 0;
for (const ch of handle) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const hue = hash % 360;

// If we keep a person page for this handle, the name points there instead of
// off-site: our own dated read is more useful to a reader than a timeline.
const person = listPeople().find(
  (p) => String(p.data.handle ?? "").toLowerCase() === handle.toLowerCase(),
);

const profileUrl = `https://x.com/${handle}`;
const postUrl = card.sourceUrls?.[0] ?? "";

// Quoting discipline. `verbatim` is the poster's own text and the archival
// record; `quoted` is the part we set in the feature when the post is longer
// than the point it is being cited for. Excerpting is ordinary editorial
// practice, but it has to be visible: the ellipsis marks the cut and the
// apparatus says so in words. `paraphrase` is OURS and can never sit in a
// blockquote -- it renders as description, in a different voice.
const full = String(card.verbatim ?? card.displayText ?? "").trim();
const quoted = String(card.quoted ?? "").trim();
const shown = quoted || full;
const described = String(card.paraphrase ?? card.summary ?? "").trim();

// Locate the excerpt inside the original so the ellipses are derived rather
// than asserted. Whitespace is normalized on both sides because a post's line
// breaks are not part of its wording, but nothing else is: if `quoted` is not
// found here, we do not know where the cut is and we say nothing about it.
// check-integrity.mjs fails the build when a quote is not a run of the source.
const squash = (s: string) => s.replace(/\s+/g, " ").trim();
const at = quoted && full ? squash(full).indexOf(squash(quoted)) : -1;
const cutBefore = at > 0;
const cutAfter = at >= 0 && at + squash(quoted).length < squash(full).length;
---

<figure class="xpost" style={`--xpost-accent: oklch(0.62 0.13 ${hue});`}>
  {shown ? (
    <blockquote class="xpost-quote" cite={postUrl}>
      {cutBefore && <span class="xpost-elision">&hellip;</span>}{shown}{cutAfter && <span class="xpost-elision xpost-elision--after">&hellip;</span>}
    </blockquote>
  ) : (
    <p class="xpost-quote xpost-quote--described">{described}</p>
  )}

  <figcaption class="xpost-attribution">
    <a class="xpost-avatar-link" href={profileUrl} aria-label={`@${handle} on X`}>
      {avatar ? (
        <img class="xpost-avatar" src={avatar} alt="" width="40" height="40" loading="lazy" />
      ) : (
        <span class="xpost-avatar xpost-avatar--monogram" aria-hidden="true">{monogram}</span>
      )}
    </a>

    <span class="xpost-who">
      {card.displayName && (
        person
          ? <a class="xpost-name" href={`/people/${person.slug}/`}>{card.displayName}</a>
          : <span class="xpost-name">{card.displayName}</span>
      )}
      <a class="xpost-handle" href={profileUrl}>@{handle}</a>
    </span>

    <span class="xpost-meta">
      {postUrl
        ? <a class="xpost-date" href={postUrl}><time datetime={card.date}>{card.date}</time></a>
        : <time class="xpost-date" datetime={card.date}>{card.date}</time>}
      {card.sourceNote && (
        <sup class="note-ref note-ref--source"><a href={`#source-${card.sourceNote}`}>{card.sourceNote}</a></sup>
      )}
      {card.handlingNote && (
        <sup class="note-ref note-ref--handling"><a href={`#handling-${card.handlingNote}`}>{card.handlingNote}</a></sup>
      )}
    </span>
  </figcaption>
</figure>
