---
import { sourceLabel, type SocialReceiptCard } from "../lib/frontier";

// `research` shows the fields a run page needs (why the post matters, what would
// settle it, tags) and an editorial embed does not. Same card either way: the
// research surface should look like the feed it came from, not like a table.
const { card, caption, research = false } = Astro.props as {
  card: SocialReceiptCard;
  caption?: string;
  research?: boolean;
};

// A post card carries someone's words, so the words are the hero. Everything
// else exists to tell the reader how much weight those words can bear. Where a
// real post shows engagement counts, this shows evidentiary status: the form is
// borrowed from X, the social proof is replaced by proof.
const STATUS_COPY: Record<string, { label: string; tone: string; note: string }> = {
  verified_secondary: {
    label: "Confirmed by a primary source",
    tone: "confirmed",
    note: "A changelog, commit, or release supports the specific claim in this post.",
  },
  refuted: {
    label: "Refuted by a primary source",
    tone: "refuted",
    note: "The primary record contradicts this post.",
  },
  needs_primary_crosscheck: {
    label: "Unverified against the source",
    tone: "open",
    note: "Reported as something that was said, not as something established.",
  },
  single_source_unconfirmed: {
    label: "Single source, unconfirmed",
    tone: "open",
    note: "One account, no independent support. Treat it as a lead.",
  },
  social_context: {
    label: "Conversation, not evidence",
    tone: "context",
    note: "Included because the discussion itself is the point.",
  },
  candidate: {
    label: "Unverified against the source",
    tone: "open",
    note: "Reported as something that was said, not as something established.",
  },
  superseded: {
    label: "Superseded",
    tone: "context",
    note: "Later evidence has overtaken this post.",
  },
};

const authors = card.authors ?? [];
const primaryAuthor = authors[0] ?? "";
// Handles arrive as "@name" or "name"; render both forms from the one value.
const handle = primaryAuthor.replace(/^@/, "").trim();
const displayName = handle
  .replace(/[_-]+/g, " ")
  .replace(/\b\w/g, (c) => c.toUpperCase())
  .trim();
const monogram = (handle.match(/[A-Za-z0-9]/)?.[0] ?? "?").toUpperCase();

const status = STATUS_COPY[card.status] ?? {
  label: card.status.replace(/_/g, " "),
  tone: "open",
  note: "",
};
const body = card.displayText ?? card.excerpt ?? card.summary ?? "";
const primaryUrl = card.sourceUrls?.[0];
const supportingUrls = (card.sourceUrls ?? []).slice(1);
const sourceNames = (card.sourceIds ?? []).map((id) => sourceLabel(id)).join(", ");
const hasEvidenceNote = Boolean(card.caveats || card.dateNote || supportingUrls.length || status.note);
---

<figure class={`xpost xpost-${status.tone}`}>
  <div class="xpost-head">
    <span class="xpost-avatar" aria-hidden="true">{monogram}</span>
    <span class="xpost-identity">
      <span class="xpost-name">{displayName || "Public post"}</span>
      {handle && <span class="xpost-handle">@{handle}</span>}
    </span>
    <span class="xpost-glyph" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="15" height="15" focusable="false">
        <path
          fill="currentColor"
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
        ></path>
      </svg>
    </span>
  </div>

  {body && <p class="xpost-body">{body}</p>}

  <div class="xpost-meta">
    <time datetime={card.date}>{card.date}</time>
    {sourceNames && <span class="xpost-topic">{sourceNames}</span>}
    {primaryUrl && <a class="xpost-link" href={primaryUrl}>View on X</a>}
  </div>

  <div class="xpost-status">
    <span class="xpost-status-dot" aria-hidden="true"></span>
    <span class="xpost-status-label">{status.label}</span>
  </div>

  {(caption || card.title) && <figcaption class="xpost-caption">{caption ?? card.title}</figcaption>}

  {research && (card.whyItMatters || card.verificationNeeded) && (
    <div class="xpost-research">
      {card.whyItMatters && (
        <p><span class="xpost-research-label">Why it matters</span>{card.whyItMatters}</p>
      )}
      {card.verificationNeeded && (
        <p><span class="xpost-research-label">What would settle it</span>{card.verificationNeeded}</p>
      )}
    </div>
  )}

  {research && card.tags?.length > 0 && (
    <div class="xpost-tags">
      {card.tags.map((tag) => <span>{tag}</span>)}
    </div>
  )}

  {hasEvidenceNote && (
    <details class="xpost-evidence">
      <summary>How we handled this</summary>
      <div>
        {status.note && <p>{status.note}</p>}
        {card.caveats && <p>{card.caveats}</p>}
        {card.dateNote && <p>{card.dateNote}</p>}
        {supportingUrls.length > 0 && (
          <p>
            Supporting links:{" "}
            {supportingUrls.map((url, index) => (
              <>
                <a href={url}>{index + 1}</a>
                {index < supportingUrls.length - 1 ? ", " : ""}
              </>
            ))}
          </p>
        )}
      </div>
    </details>
  )}
</figure>
