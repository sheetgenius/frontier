---
import Base from "../../layouts/Base.astro";
import { formatDate, listProfiles } from "../../lib/frontier";
const all = listProfiles();
const profiles = all.filter((p) => p.data.status !== "retired");
const retired = all.filter((p) => p.data.status === "retired");
---

<Base
  title="AI Coding Agent and Infrastructure Research Profiles"
  description="Dated, source-backed profiles for Codex, Claude Code, Cursor, OpenCode, Pi, OpenHands, and other projects across the coding-agent stack."
  keywords={["coding agent research profiles", "agent infrastructure research", "Codex", "Claude Code", "Cursor", "OpenCode", "Gemini CLI", "OpenHands"]}
>
  <section class="measure py-10">
    <p class="small-caps text-muted">Profiles</p>
    <h1 class="issue-title">Dated project profiles.</h1>
    <p class="publication-dek">
      One page per watched project. Each profile records what Frontier could verify at a stated date, the operator posture that follows, and the questions still open.
    </p>
    <div class="mt-9 space-y-7">
      {
        profiles.map((profile) => (
            <a class="block no-underline hover:underline" href={`/profiles/${profile.slug}/`}>
              <div class="small-caps text-muted">
                {profile.data.owner} / reviewed {formatDate(profile.data.last_updated)}
              </div>
              <h2 class="signal-title">{profile.data.label ?? profile.slug}</h2>
              {profile.data.tagline && (
                <p class="profile-row-dek">{profile.data.tagline.replace(/^"|"$/g, "")}</p>
              )}
            </a>
          ))
      }
    </div>
    {retired.length > 0 && (
      <div class="rule mt-10 pt-6">
        <p class="small-caps text-muted">No longer tracked</p>
        <p class="profile-row-dek mt-2">These pages keep their last dated posture; Frontier stopped following the projects on the date shown.</p>
        <ul class="mt-4 space-y-2">
          {retired.map((profile) => (
            <li>
              <a href={`/profiles/${profile.slug}/`}>{profile.data.label ?? profile.slug}</a>
              <span class="text-muted"> / last posture {formatDate(profile.data.last_updated)}, retired {formatDate(profile.data.retired_on)}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Base>
