---
import Base from "../../layouts/Base.astro";
import FindingFooter from "../../components/FindingFooter.astro";
import SourceTrail from "../../components/SourceTrail.astro";
import { metaDescription } from "../../lib/seo";
import { listCanonicalFindings, signalsCitingFinding, sourceLabel } from "../../lib/frontier";

export function getStaticPaths() {
  return listCanonicalFindings().map((finding) => ({
    params: { finding: finding.finding },
  }));
}

const finding = listCanonicalFindings().find((entry) => entry.finding === Astro.params.finding);
if (!finding) throw new Error("Finding not found");

const citingSignals = signalsCitingFinding(finding);
const citedSignal = citingSignals[0];
// A stub finding's markdown title is its slug. Name the page after its own
// identity rather than borrowing the citing signal's headline, which put one
// signal's title on hundreds of unrelated <title> tags.
function humanizeSlug(slug: string): string {
  const m = /^(\d{4}-\d{2}-\d{2})-(.+)$/.exec(slug);
  const words = (m ? m[2] : slug).replace(/-/g, " ");
  return m ? `${words} (${m[1]})` : words;
}
const findingTitle = finding.title === finding.finding ? humanizeSlug(finding.finding) : finding.title;
const findingSourceLabel = sourceLabel(String(finding.data.source ?? "coding agent"));
const findingKeywords = Array.from(new Set([
  findingSourceLabel,
  "coding agent finding",
  "source-backed finding",
  "agent harness",
  "Bitter Frontier",
]));
const findingDetail = finding.data.summary ?? citedSignal?.summary ?? finding.data.operator_consequence;
const findingDescription = metaDescription(
  findingDetail ? `${findingSourceLabel} source-backed coding agent finding: ${findingDetail}` : undefined,
  finding.data.summary,
  citedSignal?.summary,
  finding.data.operator_consequence,
  citedSignal?.whyActionBearing?.[0],
  finding.body,
  `${findingTitle} source-backed finding for ${findingSourceLabel}.`,
);
const findingModifiedDate = finding.data.corrected_on
  ?? finding.data.last_updated
  ?? finding.data.window?.end;
---

<Base
  {/* A finding is a receipt, not an article. 658 of them at ~140 machine-voiced
      words each were 70% of the site and the first thing search showed a
      stranger. They stay reachable from every piece that cites them, and they
      stop competing with the writing. */}
  robots="noindex,follow"
  title={`${findingTitle} | Source-Backed Finding | Bitter Frontier`}
  description={findingDescription}
  publishedDate={finding.data.window?.end}
  modifiedDate={findingModifiedDate}
  articleSection="Source-backed coding agent finding"
  authorName="Michael Ruescher"
  keywords={findingKeywords}
>
  {/* A finding is an evidence record, and it now presents as one.
      It used to open with an editor's byline over machine-written prose in
      article styling, which is the thing that reads as slop: not the sentences
      themselves, but a generated record dressed as journalism. A reader who
      clicks a receipt from an issue should know within a second that they have
      landed on the receipt. */}
  <article class="measure py-10 evidence-record">
    <p class="small-caps text-muted">Evidence record / {finding.data.source}</p>
    <p class="evidence-note">
      A dated record of one change, kept so the writing that cites it can be
      checked. Compiled from the sources listed below by the research run, not
      written for reading. The judgment lives in
      {citingSignals.length > 0 ? " the signals and issues that cite it" : " the issues that cite it"}, below.
    </p>
    <div class="prose-frontier evidence-body mt-7" set:html={finding.html} />
    <FindingFooter finding={finding} />
    <SourceTrail findings={[finding]} title="Source links" />
    <p class="rule mt-8 pt-5 font-mono text-sm text-muted">
      Versioned source: <a href={`/findings/${finding.runId}/${finding.finding}/`}>run artifact</a>
    </p>
  </article>
</Base>
