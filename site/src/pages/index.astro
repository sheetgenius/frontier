---
import Base from "../layouts/Base.astro";
import { GH_REPO_URL } from "../lib/site";
import { canonicalRunForDigest, formatDate, listAcceptedSignals, listDigests, listFeatures, listProfiles, logLinkGraphReportOnce, sourceLabel } from "../lib/frontier";
import { marked } from "marked";

logLinkGraphReportOnce();

// The front page shows work, then says who made it. Everything about how the
// publication operates -- the sweep's coverage arithmetic, the auditability
// pitch, the version history of the current issue -- moved off this page or
// below the fold.
//
// The comparison that settled it: LWN, Quanta, the Pragmatic Engineer and
// Simon Willison's site carry zero methodology on their front pages between
// them. This one carried 33% of its words. A publication that explains itself
// before it reports is a journal expecting to be evaluated, not a publication
// expecting to be read.
const digests = listDigests();
const [latest, ...earlier] = digests;
// A feature is a standalone piece with its own date; the front page shows the
// newest one or two under the lead issue, never in place of it.
const features = listFeatures().slice(0, 2);
// The series label comes from the issue, not from the template. A three-day
// Brief is not "this week"; the digest page already knew that and the front
// door did not.
const canonicalRun = latest ? canonicalRunForDigest(latest) : undefined;
const signals = listAcceptedSignals().slice(0, 6);
const profiles = listProfiles();
const profileSlugs = new Set(profiles.map((p) => p.slug));
const latestThesisHtml = latest?.data.operator_brief?.thesis
  ? marked.parseInline(latest.data.operator_brief.thesis)
  : "";

// Every project carries a written line about where it stands. Fourteen of those
// beat fourteen copies of the same date.
// No digest carries a `summary`, so the earlier-issues list would have been the
// bare titles-and-dates problem all over again. Every issue does carry an
// operator-brief thesis, and its first sentence is a written standfirst.
function standfirst(digest: any): string {
  const thesis = String(digest?.data?.operator_brief?.thesis ?? "").trim();
  if (!thesis) return "";
  // The thesis is markdown. A dek inside a linked list item should not carry
  // its own links, so keep the link text and drop the syntax.
  const flat = thesis
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/`([^`]*)`/g, "$1")
    .replace(/[*_]{1,2}([^*_]+)[*_]{1,2}/g, "$1")
    .replace(/\s+/g, " ");
  const end = flat.search(/[.!?]\s/);
  const first = end === -1 ? flat : flat.slice(0, end + 1);
  return first.length > 200 ? first.slice(0, 197).trimEnd() + "..." : first;
}

const watchlist = profiles
  .map((profile) => ({
    slug: profile.slug,
    label: sourceLabel(profile.slug),
    owner: String(profile.data.owner ?? ""),
    tagline: String(profile.data.tagline ?? "").trim(),
  }))
  .filter((p) => p.tagline);
---

<Base
  title="Bitter Frontier | Coding Agents Through the Bottleneck"
  description="Source-backed analysis of what coding agents just made possible, where the bottleneck moved, and what deserves scarce human attention."
>
  {
    latest && (
      <section class="measure lead-issue">
        <p class="small-caps eyebrow">
          {formatDate(latest.data.window?.start)} to {formatDate(latest.data.window?.end)}
          {" / "}{latest.data.series === "Bitter Frontier Brief" ? "Bitter Frontier Brief" : "This week in agentic harnesses"}
        </p>
        <a href={`/digests/${latest.slug}/`} class="no-underline">
          <h1 class="lead-issue-title">{latest.data.title}</h1>
        </a>
        {latestThesisHtml && <p class="lead-issue-dek" set:html={latestThesisHtml} />}
        <p class="lead-issue-byline">
          By <a href="/people/ruemic/">Michael Ruescher</a>
          {canonicalRun && (
            <>
              {" / "}
              <a href={`/runs/${canonicalRun.id}/`}>Research run</a>
            </>
          )}
          {" / "}
          {latest.data.signal_count} signals
        </p>

        {latest.data.operator_brief && (
          <dl class="homepage-brief">
            {latest.data.operator_brief.upgrade_check?.length > 0 && (
              <div>
                <dt class="small-caps">Upgrade / check</dt>
                <dd set:html={latest.data.operator_brief.upgrade_check[0]} />
              </div>
            )}
            {latest.data.operator_brief.try?.length > 0 && (
              <div>
                <dt class="small-caps">Try</dt>
                <dd set:html={latest.data.operator_brief.try[0]} />
              </div>
            )}
            {latest.data.operator_brief.watch?.length > 0 && (
              <div>
                <dt class="small-caps">Watch</dt>
                <dd set:html={latest.data.operator_brief.watch[0]} />
              </div>
            )}
          </dl>
        )}
        <p class="mt-5 font-mono text-sm text-muted">
          <a href={`/digests/${latest.slug}/`} class="hover:underline">Read the full issue -&gt;</a>
        </p>
      </section>
    )
  }

  {
    features.length > 0 && (
      <section class="measure rule py-8">
        <p class="small-caps eyebrow">Features</p>
        <ul class="earlier-issues">
          {features.map((feature) => (
            <li>
              <a href={`/features/${feature.slug}/`} class="earlier-issue-link">
                <span class="earlier-issue-title">{feature.data.title}</span>
              </a>
              <span class="earlier-issue-date">{formatDate(feature.data.published)}</span>
              {feature.data.dek && <p class="earlier-issue-dek">{feature.data.dek}</p>}
            </li>
          ))}
        </ul>
        <p class="mt-5 font-mono text-sm text-muted">
          <a href="/features/" class="hover:underline">All features -&gt;</a>
        </p>
      </section>
    )
  }

  {
    earlier.length > 0 && (
      <section class="measure rule py-8">
        <p class="small-caps eyebrow">Earlier issues</p>
        <ul class="earlier-issues">
          {earlier.slice(0, 4).map((digest) => (
            <li>
              <a href={`/digests/${digest.slug}/`} class="earlier-issue-link">
                <span class="earlier-issue-title">{digest.data.title}</span>
              </a>
              <span class="earlier-issue-date">{formatDate(digest.data.window?.end)}</span>
              {standfirst(digest) && <p class="earlier-issue-dek">{standfirst(digest)}</p>}
            </li>
          ))}
        </ul>
        <p class="mt-5 font-mono text-sm text-muted">
          <a href="/digests/" class="hover:underline">All issues -&gt;</a>
        </p>
      </section>
    )
  }

  <section class="measure rule py-8">
    <p class="small-caps eyebrow">What changed in the tools you run</p>
    <ol class="signal-list">
      {
        signals.map((signal) => (
          <li>
            <div class="signal-meta small-caps text-muted">
              {formatDate(signal.date)}
              {signal.sources.map((src) => (
                <span>
                  {" / "}
                  {profileSlugs.has(src) ? (
                    <a href={`/profiles/${src}/`} class="text-[var(--color-bitter)] no-underline hover:underline">
                      {sourceLabel(src)}
                    </a>
                  ) : (
                    <span>{sourceLabel(src)}</span>
                  )}
                </span>
              ))}
            </div>
            <h3 class="signal-title">
              <a href={`/signals/${signal.id}/`} class="no-underline hover:underline">{signal.title}</a>
            </h3>
            {signal.whyActionBearing.length > 0 ? (
              <p class="signal-summary">{signal.whyActionBearing[0]}</p>
            ) : signal.summary ? (
              <p class="signal-summary">{signal.summary}</p>
            ) : null}
          </li>
        ))
      }
    </ol>
    <p class="mt-6 font-mono text-sm text-muted">
      <a href="/signals/" class="hover:underline">All AI coding agent signals -&gt;</a>
    </p>
  </section>

  <section class="measure rule py-8">
    <p class="small-caps eyebrow">The watchlist</p>
    <ul class="watchlist">
      {watchlist.map((project) => (
        <li>
          <a href={`/profiles/${project.slug}/`} class="watchlist-link">
            <span class="watchlist-name">{project.label}</span>
            {project.owner && <span class="watchlist-owner">{project.owner}</span>}
          </a>
          <p class="watchlist-tagline">{project.tagline}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="measure rule py-8 publication-about">
    <p class="small-caps eyebrow">About this publication</p>
    <h2 class="publication-title">Coding agents can create work faster than teams can verify it.</h2>
    <p class="publication-dek">
      Source-backed, cross-project reporting on what coding agents just made possible, what became the new
      bottleneck, and where operators should spend scarce human attention. Every claim links to a primary
      source you can open and check, and the whole publication is on
      <a href={GH_REPO_URL}>GitHub</a>, source notes and all.
    </p>
    <dl class="publication-axioms">
      <div>
        <dt><a href="/bitter-lesson/">Bitter Lesson Maxing</a></dt>
        <dd>Build where improving general agents compound your advantage, not where their next release erases it.</dd>
      </div>
      <div>
        <dt><a href="/amdahls-law/">Amdahl Maxing</a></dt>
        <dd>Treat human attention as the scarce serial resource and spend it where judgment changes the outcome.</dd>
      </div>
    </dl>
    <p class="issue-meta">
      Edited by <a href="/people/ruemic/">Michael Ruescher</a> (<a href="https://x.com/ruemic">@ruemic</a>). Published by <a href="https://bitter.sh">Bitter</a>.
      <a href="/rss.xml">Subscribe by RSS</a>.
      <a href="/letter/">Read the thesis</a>.
    </p>
  </section>
</Base>
